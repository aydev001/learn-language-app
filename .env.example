# =============================================================================
# Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.
# `.env` git'ga tushmaydi (.gitignore da).
# =============================================================================

# --- Telegram bot ------------------------------------------------------------
# @BotFather dan olinadi. Ilova foydalanuvchini shu token orqali tekshiradi.
# BO'LMASA: ilova hech kimni kiritmaydi (401), faqat ALLOW_DEV_USER=1 bilan ishlaydi.
TELEGRAM_BOT_TOKEN=

# Ilovaning tashqi HTTPS manzili — bot shu havolani o'quvchiga yuboradi.
# Vercel'da avtomatik aniqlanadi. Lokal tunnel uchun:
#   npm run tg:setup -- https://xxx.trycloudflare.com
# (skript bu qatorni o'zi yozib qo'yadi)
PUBLIC_APP_URL=

# --- Ovoz o'qib berish (TTS) --------------------------------------------------
# "google" (tavsiya, arzon) yoki "openai".
# Tanlangan provayder kalitsiz qolsa, ikkinchisiga avtomatik o'tadi.
TTS_PROVIDER=google

# Google Cloud TTS kaliti.
#   1. https://console.cloud.google.com → loyiha yarating
#   2. "Cloud Text-to-Speech API" ni yoqing
#   3. APIs & Services → Credentials → Create credentials → API key
# Oyiga 1M belgi bepul — bizning matnlar uchun bu juda ko'p.
GOOGLE_TTS_API_KEY=

# Ovozni tanlash. Wavenet/Neural2 — SSML qo'llab-quvvatlaydi (urg'uni
# aniq boshqarish mumkin). Chirp3-HD tabiiyroq, lekin SSML'siz.
#   ru-RU-Wavenet-A / B / C / D / E
#   ru-RU-Chirp3-HD-Aoede va boshqalar
GOOGLE_TTS_VOICE=ru-RU-Wavenet-C

# --- OpenAI ------------------------------------------------------------------
# https://platform.openai.com/api-keys
# Talaffuz tahlili (nutqni matnga aylantirish + izoh) shu kalit bilan ishlaydi.
# BO'LMASA: o'qish moduli tahlil qilmaydi, qolgani ishlayveradi.
OPENAI_API_KEY=

# Modellarni almashtirmoqchi bo'lsangiz (ixtiyoriy):
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# --- MongoDB Atlas -----------------------------------------------------------
# https://cloud.mongodb.com — bepul M0 klaster yetarli.
# BO'LMASA: ma'lumot faqat server xotirasida saqlanadi va qayta ishga
# tushirilganda yo'qoladi. Dev uchun qulay, production uchun yaramaydi.
MONGODB_URI=
MONGODB_DB=learn_russian

# --- Admin -------------------------------------------------------------------
# O'qituvchining Telegram ID raqami (@userinfobot dan bilib olasiz).
# Vergul bilan bir nechta: 123456789,987654321
ADMIN_TELEGRAM_IDS=

# --- Xarajat nazorati ---------------------------------------------------------
# Oylik chegara (dollarda). Oshib ketsa YANGI ovoz sintezi to'xtaydi, lekin
# oldindan tayyorlangan (keshdagi) audio ishlayveradi — o'quvchi sezmaydi ham.
# 0 — chegara o'chirilgan.
MONTHLY_BUDGET_USD=4

# 1 bo'lsa talaffuz tahlili modelga bormaydi — soxta, lekin haqiqiy ko'rinishdagi
# hisobot qaytaradi. Tahlil ekranini bepul sozlash uchun ishlatiladi.
# Ovoz yozib, tugmalarni bosib ko'rish mumkin — pul ketmaydi.
MOCK_PRONUNCIATION=0

# --- Ovozli suhbat (kino uyi) -------------------------------------------------
# Ovoz serverdan o'tmaydi: brauzerlar to'g'ridan-to'g'ri ulanadi. Ularga
# faqat "tashqi manzilingiz shu" deb aytadigan STUN server kerak va u bepul.
# BO'LMASA: Google'ning ochiq STUN serverlari ishlatiladi — odatda yetarli.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
#
# TURN — ovozni o'zidan o'tkazadigan zaxira. U faqat qattiq NAT ortidagi
# (ba'zi mobil operatorlar, korporativ Wi-Fi) foydalanuvchilar uchun kerak
# va pullik. BO'LMASA: bunday tarmoqdagi odamlarda ovoz ulanmaydi, ekranda
# "tarmoq to'g'ridan-to'g'ri aloqaga ruxsat bermayapti" deb chiqadi.
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_PASSWORD=

# --- Ishlab chiqish ----------------------------------------------------------
# 1 bo'lsa, ilovani Telegramsiz — oddiy brauzerda ochish mumkin.
# PRODUCTION'DA HECH QACHON 1 QILMANG: har kim kira oladi.
ALLOW_DEV_USER=1

# Lokal sinov haqiqiy ma'lumotlarga tegmasligi uchun `.env.local` faylida
# boshqa baza nomini bering (u git'ga tushmaydi va faqat `npm run dev` da
# o'qiladi):
#
#   MONGODB_DB=learn_russian_dev
#   ALLOW_DEV_USER=1
