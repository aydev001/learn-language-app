# =============================================================================
# Vercel'ga qo'yiladigan muhit o'zgaruvchilari (Settings -> Environment Variables)
# Bu fayl namuna — Vercel'ga qo'lda kiritiladi, deploy qilinmaydi.
# =============================================================================

TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
MONGODB_URI=
MONGODB_DB=learn_russian

# O'qituvchi(lar)ning Telegram ID raqami
ADMIN_TELEGRAM_IDS=

# Oylik xarajat chegarasi
MONTHLY_BUDGET_USD=4

# PUBLIC_APP_URL — Vercel o'zi aniqlaydi, qo'lda yozish shart emas.
# ALLOW_DEV_USER — production'da kod darajasida o'chirilgan, yozmang.
# MOCK_PRONUNCIATION — production'da yozmang.
